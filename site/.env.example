# Copy to .env for local builds. Never commit real secrets (none are needed for this site).
# Public download destination. Leave empty to show the honest "coming soon" state.
PUBLIC_DOWNLOAD_URL=
# Public origin once a domain exists, e.g. https://trillian.example
SITE_URL=
# Sub-path when hosted as a GitHub Pages project site, e.g. /trillian-website
BASE_PATH=/
