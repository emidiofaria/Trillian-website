---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  level?: 'h1' | 'h2';
  center?: boolean;
}
const { id, eyebrow, title, level = 'h2', center = false } = Astro.props;
const Tag = level;
---

<div class:list={['section-heading', { center }]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <Tag id={id}>{title}</Tag>
  {
    Astro.slots.has('default') && (
      <p class="lead">
        <slot />
      </p>
    )
  }
</div>

<style>
  .section-heading {
    margin-bottom: var(--sp-6);
    max-width: 48rem;
  }
  .center {
    text-align: center;
    margin-inline: auto;
  }
  .center .lead {
    margin-inline: auto;
  }
</style>
