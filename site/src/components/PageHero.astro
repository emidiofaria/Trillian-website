---
interface Props {
  eyebrow: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<header class="page-hero">
  <div class="container">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    {
      Astro.slots.has('default') && (
        <p class="lead">
          <slot />
        </p>
      )
    }
    <slot name="after" />
  </div>
</header>

<style>
  .page-hero {
    padding-block: var(--sp-8) var(--sp-6);
    border-bottom: 1px solid var(--border);
    background: radial-gradient(50rem 20rem at 80% 0%, rgb(75 143 255 / 0.12), transparent 60%);
  }
</style>
