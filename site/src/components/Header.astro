---
import { Image } from 'astro:assets';
import helmet from '../assets/helmet.png';
import { nav } from '../config/site';
import { url, isCurrent } from '../lib/url';

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={url('/')} aria-label="Trillian — Driving Coach, home">
      <Image src={helmet} alt="" width={52} height={52} loading="eager" />
      <span class="wordmark">TRILLIAN</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-menu-toggle
    >
      <span class="visually-hidden">Menu</span>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
        <path class="l1" d="M3 6h18"></path>
        <path class="l2" d="M3 12h18"></path>
        <path class="l3" d="M3 18h18"></path>
      </svg>
    </button>

    <nav id="primary-nav" class="nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={url(item.href)}
                aria-current={isCurrent(item.href, path) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="nav-cta">
          <a
            class="btn btn--primary btn--sm"
            href={url('/download/')}
            aria-current={isCurrent('/download/', path) ? 'page' : undefined}>Download</a
          >
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const navEl = document.getElementById('primary-nav');
  if (toggle && navEl) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      navEl.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () =>
      setOpen(toggle.getAttribute('aria-expanded') !== 'true'),
    );
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navEl.classList.contains('is-open')) {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 60rem)').addEventListener('change', () => setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(11 15 23 / 0.88);
    backdrop-filter: saturate(150%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    min-height: var(--header-h);
    flex-wrap: wrap;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    color: var(--text);
    text-decoration: none;
  }
  .brand img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
  }
  .wordmark {
    font-weight: 800;
    letter-spacing: 0.22em;
    font-size: 1.375rem;
  }
  @media (max-width: 25rem) {
    .brand img {
      width: 44px;
      height: 44px;
    }
    .wordmark {
      font-size: 1.2rem;
      letter-spacing: 0.18em;
    }
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-2);
  }
  .nav li + li {
    margin-top: 0;
  }
  .nav a:not(.btn) {
    display: inline-block;
    padding: var(--sp-2) var(--sp-3);
    color: var(--text-soft);
    text-decoration: none;
    font-size: var(--fs-sm);
    border-radius: var(--radius-sm);
  }
  .nav a:not(.btn):hover {
    color: var(--text);
    background: var(--surface);
  }
  .nav a[aria-current='page']:not(.btn) {
    color: var(--text);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .nav-cta {
    margin-left: var(--sp-2);
  }

  .menu-toggle {
    display: none;
    background: transparent;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--text);
    padding: var(--sp-2);
    cursor: pointer;
  }
  .menu-toggle path {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    transition:
      transform 0.2s var(--ease),
      opacity 0.2s;
    transform-origin: center;
  }
  .menu-toggle[aria-expanded='true'] .l1 {
    transform: translateY(6px) rotate(45deg);
  }
  .menu-toggle[aria-expanded='true'] .l2 {
    opacity: 0;
  }
  .menu-toggle[aria-expanded='true'] .l3 {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile: collapse only when JS is available; without JS the nav simply wraps below the brand. */
  @media (max-width: 59.99rem) {
    :global(html.js) .menu-toggle {
      display: inline-flex;
    }
    :global(html.js) .nav {
      display: none;
      flex-basis: 100%;
      padding-bottom: var(--sp-4);
    }
    :global(html.js) .nav.is-open {
      display: block;
    }
    .nav ul {
      flex-direction: column;
      align-items: stretch;
    }
    .nav a:not(.btn) {
      display: block;
      padding: var(--sp-3);
      font-size: var(--fs-base);
    }
    .nav-cta {
      margin: var(--sp-2) 0 0;
    }
    .nav-cta .btn {
      width: 100%;
    }
    :global(html:not(.js)) .nav {
      flex-basis: 100%;
    }
  }
</style>
