---
/**
 * Abstract sector map: one closed circuit outline split into three equal thirds by distance
 * (pathLength = 300 → each sector is exactly 100 units). Mirrors the in-app Coach tab colours.
 */
interface Props {
  caption?: boolean;
}
const { caption = true } = Astro.props;
const d =
  'M 80 210 L 300 210 C 360 210 380 180 360 140 L 330 90 C 310 55 270 50 245 75 L 215 105 C 195 125 165 120 150 95 L 130 60 C 115 35 70 35 55 70 L 35 140 C 25 185 45 210 80 210 Z';
---

<figure class="sector-map">
  <svg viewBox="0 0 400 250" role="img" aria-labelledby="sm-title sm-desc">
    <title id="sm-title">Sector map example</title>
    <desc id="sm-desc">
      An abstract circuit outline divided into three equal parts by distance: sector 1 in blue,
      sector 2 in purple and sector 3 in orange, with a gold start/finish marker.
    </desc>
    <path d={d} class="base" pathLength="300"></path>
    <path d={d} class="seg s1" pathLength="300" stroke-dasharray="100 200" stroke-dashoffset="0"
    ></path>
    <path d={d} class="seg s2" pathLength="300" stroke-dasharray="0 100 100 100"></path>
    <path d={d} class="seg s3" pathLength="300" stroke-dasharray="0 200 100 0"></path>
    <line x1="80" y1="196" x2="80" y2="224" class="sf"></line>
    <circle cx="80" cy="210" r="7" class="sf-dot"></circle>
    <path d="M 120 228 l 14 -6 l -14 -6" class="dir" aria-hidden="true"></path>
    <text x="210" y="238" class="lbl l1">S1</text>
    <text x="378" y="150" class="lbl l2">S2</text>
    <text x="96" y="30" class="lbl l3">S3</text>
    <text x="40" y="242" class="lbl sf-lbl">Start/finish</text>
  </svg>
  {
    caption && (
      <figcaption class="small muted">
        <span class="key k1">S1 — first third</span>
        <span class="key k2">S2 — middle third</span>
        <span class="key k3">S3 — final third</span>
        <span class="note">
          Equal thirds of the lap by distance — the app's own sectors, not the circuit's official
          timing sectors.
        </span>
      </figcaption>
    )
  }
</figure>

<style>
  .sector-map {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: var(--sp-5);
  }
  svg {
    width: 100%;
    height: auto;
  }
  .base {
    fill: none;
    stroke: #263247;
    stroke-width: 18;
    stroke-linejoin: round;
  }
  .seg {
    fill: none;
    stroke-width: 8;
    stroke-linejoin: round;
  }
  .s1 {
    stroke: var(--sector-1);
  }
  .s2 {
    stroke: var(--sector-2);
  }
  .s3 {
    stroke: var(--sector-3);
  }
  .sf {
    stroke: var(--gold);
    stroke-width: 3;
  }
  .sf-dot {
    fill: var(--gold);
  }
  .dir {
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
  }
  .lbl {
    font: 700 14px var(--font-mono);
  }
  .l1 {
    fill: var(--sector-1);
  }
  .l2 {
    fill: var(--sector-2);
  }
  .l3 {
    fill: var(--sector-3);
  }
  .sf-lbl {
    font-size: 11px;
    font-weight: 400;
    fill: var(--gold);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-4);
    margin-top: var(--sp-4);
  }
  .key::before {
    content: '';
    display: inline-block;
    width: 0.75em;
    height: 0.75em;
    border-radius: 2px;
    margin-right: 0.4em;
    vertical-align: middle;
  }
  .k1::before {
    background: var(--sector-1);
  }
  .k2::before {
    background: var(--sector-2);
  }
  .k3::before {
    background: var(--sector-3);
  }
  .note {
    flex-basis: 100%;
  }
</style>
