---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PhoneFrame from '../components/PhoneFrame.astro';
import LapTableMock from '../components/LapTableMock.astro';
import SectorDiagram from '../components/SectorDiagram.astro';
import Callout from '../components/Callout.astro';
import CtaDownload from '../components/CtaDownload.astro';
import PageHero from '../components/PageHero.astro';
import Toc from '../components/Toc.astro';
import analysisShot from '../assets/screens/analysis.png';
import cornersShot from '../assets/screens/analysis-corners.png';
import coachShot from '../assets/screens/coach.png';
import { coachingCards } from '../content/data';
import { url } from '../lib/url';

const toc = [
  ['lap-detection', 'Lap detection'],
  ['circuits', 'Circuits'],
  ['lap-times', 'Lap times & sectors'],
  ['charts', 'Speed charts'],
  ['analysis', 'Analysis tab'],
  ['coaching', 'Coaching'],
  ['history', 'History & sharing'],
  ['offline', 'Offline-first'],
] as const;
---

<BaseLayout
  title="Features"
  description="Explore Trillian’s features: automatic GPS lap detection, a circuit library, lap and sector comparison, speed charts, a track-map analysis tab and honest post-session coaching — all on your Android phone."
>
  <PageHero eyebrow="Features" title="A race engineer’s debrief, in your pocket">
    Everything Trillian does happens after you climb out of the car — measured from your own GPS
    recording, on your own phone.
    <Toc slot="after" items={toc} />
  </PageHero>

  <Section id="lap-detection" labelledby="ld-title">
    <SectionHeading id="ld-title" eyebrow="01 · Lap detection" title="Laps detected automatically">
      Tell Trillian where the start/finish line is and it splits your session into laps from your
      GPS trace. Lap times appear as soon as you stop recording.
    </SectionHeading>
    <div class="grid grid--3">
      <div class="card">
        <h3>Crossing the line</h3>
        <p>A lap is counted each time you cross the start/finish line you set up or selected.</p>
      </div>
      <div class="card">
        <h3>False triggers filtered</h3>
        <p>
          Laps must last at least 20 seconds and take you at least 50 metres from the line — so a
          wobble across it isn’t counted. Small kart tracks work fine.
        </p>
      </div>
      <div class="card">
        <h3>Direction worked out for you</h3>
        <p>
          Capture the two line points in either order: the app works out your driving direction from
          the recording itself.
        </p>
      </div>
    </div>
  </Section>

  <Section id="circuits" tone="alt" labelledby="c-title">
    <SectionHeading
      id="c-title"
      eyebrow="02 · Circuits"
      title="Select a track — or set up a new one"
    >
      Starting a session asks one question: <em>Where are you driving?</em>
    </SectionHeading>
    <div class="grid grid--2">
      <div class="card">
        <h3>SELECT TRACK</h3>
        <p>
          Pick a circuit that ships with Trillian or one you saved earlier. Built-in circuits have
          had their start/finish line and track outline surveyed on foot, so the app knows:
        </p>
        <ul>
          <li>which way you drive through the start/finish,</li>
          <li>roughly how long a lap should take, and</li>
          <li>
            the shape of the track — so paddock time isn’t counted into your session distance.
          </li>
        </ul>
        <p class="small muted">
          The list works with no signal. Open it in the app for the current circuits.
        </p>
      </div>
      <div class="card">
        <h3>NEW CIRCUIT</h3>
        <p>
          Somewhere new? Walk to one edge of the track at the start/finish, capture point A, walk
          across and capture point B. Then choose <strong>SAVE &amp; START</strong> to keep the circuit
          for next time, or <strong>JUST START</strong> for this session only.
        </p>
        <p>Saved circuits can be renamed or deleted at any time.</p>
      </div>
    </div>
  </Section>

  <Section id="lap-times" labelledby="lt-title">
    <div class="split">
      <div>
        <SectionHeading
          id="lt-title"
          eyebrow="03 · Lap times & sectors"
          title="Every lap, every sector, every delta"
        >
          The Laps tab lists each lap with its time, three sector times and the difference to your
          best. A star marks your fastest lap.
        </SectionHeading>
        <h3>What are sectors?</h3>
        <p>
          Each lap is split into <strong>three equal thirds by distance</strong>. Sector 1 is the
          first third of the way round, sector 2 the middle, sector 3 the last.
        </p>
        <p>
          These are the app’s own sectors, <strong>not the circuit’s official timing sectors</strong
          >. They’re made for comparing your laps against each other — which is what matters for
          improving.
        </p>
        <p class="small muted">
          If the GPS gave too few fixes on a lap to divide it honestly, that lap shows no sector
          times rather than a guess.
        </p>
      </div>
      <SectorDiagram />
    </div>
    <div class="mt">
      <LapTableMock />
    </div>
  </Section>

  <Section id="charts" tone="alt" labelledby="ch-title">
    <SectionHeading
      id="ch-title"
      eyebrow="04 · Speed charts"
      title="Speed by distance, lap over lap"
    >
      The Chart tab plots your speed (km/h) against distance from the start/finish line. Your best
      lap is drawn in blue and every other lap in grey.
    </SectionHeading>
    <div class="grid grid--3">
      <div class="card">
        <h3>Why distance, not time?</h3>
        <p>
          Every corner sits at the same point on the X-axis, so you can compare braking points,
          corner entry and exit speeds lap against lap.
        </p>
      </div>
      <div class="card">
        <h3>Fast or Detailed</h3>
        <p>
          For sessions of 10+ laps, choose <strong>Fast</strong> for a quick, lightly smoothed view or
          <strong>Detailed</strong> for full resolution.
        </p>
      </div>
      <div class="card">
        <h3>No internet needed</h3>
        <p>Charts are processed locally from your telemetry file.</p>
      </div>
    </div>
  </Section>

  <Section id="analysis" labelledby="an-title">
    <SectionHeading id="an-title" eyebrow="05 · Analysis tab" title="Your post-session debrief">
      The sort of sheet a race engineer hands you when you climb out of the car — worked out on your
      phone, with no signal needed.
    </SectionHeading>
    <div class="split">
      <div>
        <h3>Session at a glance</h3>
        <p>Total distance, session duration, max speed, average speed and best lap.</p>
        <h3>Speed-coloured track map</h3>
        <p>
          Drawn from your own GPS trace: the line’s colour shows your speed, red stretches show
          where you braked, <span class="mono">T1, T2, T3…</span> mark the corners the app found, and
          a gold marker shows the start/finish. Tap a lap chip to redraw it for any lap.
        </p>
        <h3>Corners</h3>
        <p>
          Direction, degrees turned and your <strong>apex speed</strong> — the slowest point through the
          corner, and often where lap time hides.
        </p>
        <h3>Braking zones</h3>
        <p>
          Entry and exit speed, speed shed, time on the brakes and peak g — measured from how fast
          your GPS speed drops, not from the phone’s motion sensors, which depend on how the phone
          is mounted.
        </p>
        <h3>Speed over the session</h3>
        <p>A graph of every lap, in-laps and out-laps included.</p>
        <Callout title="The app’s corners, not the circuit’s">
          <p>
            Corners are numbered in the order you drove through them, based on how your car changed
            direction. They won’t always match the circuit’s official map.
          </p>
        </Callout>
      </div>
      <div class="shots">
        <PhoneFrame
          src={analysisShot}
          width={280}
          alt="Analysis tab for a three-lap session: total distance 2.54 km, duration 4:53, max speed 68.9 km/h, average speed 30.1 km/h, best lap 1:16.413, and the top of a speed-coloured track map with corners T1 to T4."
        />
        <PhoneFrame
          src={cornersShot}
          width={280}
          alt="Braking zones list showing entry and exit speeds, speed shed, peak g and duration for each zone with its corner, followed by a speed-over-the-session graph."
        />
      </div>
    </div>
  </Section>

  <Section id="coaching" tone="alt" labelledby="co-title">
    <div class="split split--reverse">
      <div>
        <SectionHeading
          id="co-title"
          eyebrow="06 · Coaching"
          title="Insights your data can actually support"
        >
          The Coach tab shows a sector map of the circuit and between one and seven cards, depending
          on what your session supports. A missing card is the app being honest, not broken.
        </SectionHeading>
        <div class="table-wrap" tabindex="0" role="region" aria-labelledby="cards-cap">
          <table>
            <caption id="cards-cap" class="visually-hidden"
              >Coaching cards and when they appear</caption
            >
            <thead>
              <tr><th scope="col">Card</th><th scope="col">When you’ll see it</th></tr>
            </thead>
            <tbody>
              {
                coachingCards.map((c) => (
                  <tr>
                    <>
                      <td>
                        <strong>{c.name}</strong>
                      </td>
                      <td>{c.when}</td>
                    </>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <h3>Your Dream Lap</h3>
        <p>
          Your fastest sector 1, sector 2 and sector 3 from anywhere in the session, added together
          — the lap you’ve already driven in pieces but never in one go. The gap to your real best
          lap is the time sitting on the table.
        </p>
        <p class="small muted">
          The Dream Lap appears only when there are at least 3 good laps and the sector data checks
          out. If the app suspects two laps were recorded as one, it shows no Dream Lap rather than
          a time you never drove.
        </p>
        <Callout tone="warn" title="After the session, never during">
          <p>Coaching is post-session only. There is no live or audio coaching while you drive.</p>
        </Callout>
      </div>
      <PhoneFrame
        src={coachShot}
        width={300}
        alt="Coach tab with a 91.4% consistency score card and insight cards: Lap 2 Was Your Fastest, Top Speed 69 km/h, and Solid Consistency."
      />
    </div>
  </Section>

  <Section id="history" labelledby="h-title">
    <SectionHeading
      id="h-title"
      eyebrow="07 · History & sharing"
      title="Track your progress, share your best"
    />
    <div class="grid grid--3">
      <div class="card">
        <h3>Session history</h3>
        <p>
          Home shows your all-time best lap and your recent sessions, newest first. Long-press a
          session to rename or delete it.
        </p>
      </div>
      <div class="card">
        <h3>Driver profile</h3>
        <p>
          Your driver name, total sessions, total laps and all-time best lap. Rename yourself any
          time — your sessions are untouched.
        </p>
      </div>
      <div class="card">
        <h3>Share cards</h3>
        <p>
          Tap <strong>Share</strong> on a session to create an image card with your best lap, track, date
          and driver name — then send it through any app on your phone.
        </p>
      </div>
    </div>
  </Section>

  <Section id="offline" tone="alt" labelledby="o-title">
    <SectionHeading
      id="o-title"
      eyebrow="08 · Offline-first"
      title="No signal at the circuit? No problem."
    >
      Lap detection, the speed chart, the track map and coaching all run on your phone. Trillian
      works fully in flight mode, needs no account, and keeps your data in its private storage on
      the device.
    </SectionHeading>
    <p><a href={url('/privacy/')}>How Trillian handles your data →</a></p>
  </Section>

  <Section labelledby="f-cta">
    <div class="btn-row">
      <h2 id="f-cta" class="visually-hidden">Get started</h2>
      <CtaDownload />
      <a class="btn btn--ghost" href={url('/how-it-works/')}>See how it works</a>
    </div>
  </Section>
</BaseLayout>

<style>
  .mt {
    margin-top: var(--sp-6);
  }
  .shots {
    display: grid;
    gap: var(--sp-6);
  }
  .card ul {
    padding-left: 1.2rem;
  }
</style>
